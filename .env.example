# OPENAI_API_KEY: Required for the OpenAI API calls made by the server.
# Keep this only in .env.local or your deployment secret manager; never expose it in client code.
OPENAI_API_KEY=""
# Optional: choose a compatible Responses API model.
OPENAI_MODEL="gpt-4.1-mini"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Langflow Integration (Opcional - Orquestador visual de flujos de IA)
LANGFLOW_URL="http://127.0.0.1:7860"
LANGFLOW_FLOW_ID="aquatwin-limnology-copilot"
# LANGFLOW_APPLICATION_TOKEN="tu-token-opcional"

# Dataset de Entrenamiento y Validación OAPAT (Mediciones reales de Falling Creek Reservoir)
OAPAT_DATASET_CSV="gd_python/early_warning/data/datasets/fcr_oapat.csv"


